# Copie para .env e preencha antes de rodar o servidor (dev ou produção).
# NUNCA commite o .env de verdade — .gitignore já cobre isso.

# Obrigatório. Segredo usado pra assinar os tokens de login (JWT). Gere um
# valor aleatório longo (ex.: `openssl rand -hex 32`) — trocar esse valor em
# produção desloga todo mundo instantaneamente.
JWT_SECRET=

# Porta que o servidor Express escuta. Em hospedagens gerenciadas (ex.: o
# "Deploy Web App" da Hostinger) a plataforma costuma injetar essa variável
# sozinha — só defina manualmente se estiver rodando num VPS por conta própria.
PORT=4000

# Obrigatórios. Credenciais do banco MySQL gerenciado (ex.: o banco criado
# pelo painel da Hostinger em "Bancos de dados"). Não dá pra usar SQLite em
# produção nessa hospedagem — o diretório do app é recriado do zero a cada
# deploy, então um arquivo local se perderia a cada atualização do site.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Opcional. Restringe o CORS da API a uma origem específica. Sem essa
# variável, a API aceita requisições de qualquer origem (aberto) — como o
# front roda no mesmo domínio da API em produção, isso raramente importa na
# prática, mas dá pra travar se quiser bloquear scraping de outro domínio.
# ALLOWED_ORIGIN=https://seusite.com
