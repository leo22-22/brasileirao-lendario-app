# Copie para .env (raiz do projeto) se quiser configurar. Nenhuma variável
# aqui é obrigatória.
# Variáveis VITE_* ficam embutidas no build do front (não são segredo de
# servidor — não coloque nada sensível aqui além de um usuário/senha de TURN
# de baixo risco).

# ATENÇÃO: para configurar TURN (o que faz o multiplayer funcionar em 4G e em
# Wi-Fi de faculdade), prefira as variáveis TURN_* do server/.env.example.
# O servidor emite credenciais que expiram sozinhas via /api/turn, e o segredo
# nunca chega no navegador. As variáveis abaixo continuam funcionando, mas
# ficam gravadas no bundle do front, à vista de qualquer um.

# Opcional. Credenciais fixas de um servidor TURN.
# VITE_TURN_URL=turn:seu-servidor-turn:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Aceita vários endereços separados por vírgula — o de TCP/443 é o que
# atravessa rede corporativa/escola que só libera tráfego web:
# VITE_TURN_URL=turn:SEU-HOST:3478,turns:SEU-HOST:443?transport=tcp
